{
  "name": "jugginai-ai-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "2cc3a4ec0dbc3969ca8c25a0c20a2465",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  // Non-secret config. Secrets are set with `wrangler secret put` and never committed.
  "vars": {
    "LANGFUSE_BASE_URL": "https://us.cloud.langfuse.com",
    "PC_BRIDGE_URL": "https://pc.jugginai.net",
    "PINECONE_INDEX": "jugginai-rag"
  },
  "r2_buckets": [
    { "binding": "RAG_BUCKET", "bucket_name": "jugginai" }
  ]
}
